# Passwords used to create the Kubernetes secrets (make secrets).
# "make secrets" copies this file to .env if .env does not exist.
# These are demo values for a local cluster: change them in .env if you want.
# .env is in .gitignore.

# S3 storage (SeaweedFS)
S3_ACCESS_KEY=ginflix-s3
S3_SECRET_KEY=ginflix-s3-secret

# Keycloak administration console (http://auth.ginflix.localhost:8088)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin-ginflix
